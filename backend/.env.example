# Copy this file to .env and fill in your keys. All optional except LLM.

# --- LLM (primary: Azure AI Foundry; fallbacks: OpenRouter → Groq) ---
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_OPENAI_KEY=xxxx
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
OPENROUTER_API_KEY=sk-or-v1-xxxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GROQ_API_KEY=gsk_xxxx

# --- Embeddings (free) ---
# Tries the list in order until one works; falls back to BM25 keyword search if all fail.
OPENROUTER_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# --- Database (free options: Neon / Supabase / Railway) ---
# Any Postgres works — embeddings stored as JSONB, cosine computed in JS,
# so you do NOT need pgvector. Azure Postgres also fine.
DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Optional integrations ---
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default
COMPOSIO_JIRA_PROJECT_KEY=COACH
COMPOSIO_REFUND_EMAIL=
COMPOSIO_SLACK_CHANNEL=#support-ops

# --- Local dev port ---
PORT=8000
